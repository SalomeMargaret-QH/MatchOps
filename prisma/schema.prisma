generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  PUBLISHER
  ADMIN
}

enum OpportunityStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum InteractionType {
  VIEW
  ACCEPT
  IGNORE
  SAVE
  SHARE
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model User {
  id                 String             @id @default(cuid())
  email              String?            @unique
  passwordHash       String?
  name               String?
  role               UserRole           @default(CANDIDATE)
  reputationPoints   Int                @default(0)
  profileScore       Int                @default(0)
  isCurrentlyWorking Boolean?           @default(false)
  currentCompany     String?
  currentRole        String? // Agregado correctamente aquí para el puesto actual
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  anonymousSessions  AnonymousSession[]
  opportunities      Opportunity[]      @relation("PublisherOpportunities")
  interactions       Interaction[]
  implicitProfile    ImplicitProfile?
  saved              SavedOpportunity[]
  sentMessages       Message[]          @relation("SentMessages")
  receivedMessages   Message[]          @relation("ReceivedMessages")
  conversationsA     Conversation[]     @relation("CandidateConversations")
  conversationsB     Conversation[]     @relation("PublisherConversations")
  authSessions       AuthSession[]
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AnonymousSession {
  id              String           @id @default(cuid())
  token           String           @unique
  convertedAt     DateTime?
  expiresAt       DateTime
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  interactions    Interaction[]
  implicitProfile ImplicitProfile?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Opportunity {
  id            String             @id @default(cuid())
  title         String
  description   String
  tags          String[]
  workMode      WorkMode
  location      String?
  contractType  String
  compensation  String?
  status        OpportunityStatus  @default(ACTIVE)
  publisherId   String
  publisher     User               @relation("PublisherOpportunities", fields: [publisherId], references: [id], onDelete: Cascade)
  interactions  Interaction[]
  savedBy       SavedOpportunity[]
  conversations Conversation[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  archivedAt    DateTime?
}

model Interaction {
  id                 String            @id @default(cuid())
  type               InteractionType
  dwellTimeSeconds   Int?
  opportunityId      String
  opportunity        Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousSessionId String?
  anonymousSession   AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
}

model ImplicitProfile {
  id                 String            @id @default(cuid())
  interests          String[]
  skills             String[]
  preferredWorkMode  WorkMode?
  availability       String?
  confidence         Int               @default(0)
  userId             String?           @unique
  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSessionId String?           @unique
  anonymousSession   AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model SavedOpportunity {
  id            String      @id @default(cuid())
  userId        String
  opportunityId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, opportunityId])
}

model Conversation {
  id            String      @id @default(cuid())
  candidateId   String
  publisherId   String
  opportunityId String
  candidate     User        @relation("CandidateConversations", fields: [candidateId], references: [id], onDelete: Cascade)
  publisher     User        @relation("PublisherConversations", fields: [publisherId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  messages      Message[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Message {
  id             String        @id @default(cuid())
  body           String
  status         MessageStatus @default(SENT)
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  receiverId     String
  sender         User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User          @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  readAt         DateTime?
}
